<?xml version="1.0" encoding="utf-8"?>
<!--
  The transactions box holds financial history and verbatim bank SMS. Even
  encrypted, it must not leave the device: the key lives in the Keystore and
  does not travel with a backup, so a restored copy would be unopenable anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
